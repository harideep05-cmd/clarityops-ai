# Copy to backend/.env. Never put the Gemini key in frontend environment variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# demo retains the original local workspace; members uses isolated company memberships.
CLARITYOPS_AUTH_MODE=demo
# private requires members authentication and exact HTTPS CORS origins; TLS is provided by your proxy.
CLARITYOPS_DEPLOYMENT=local
# Demo mode only: at least 32 random characters; scripts/init_env.py generates this locally.
CLARITYOPS_ACCESS_TOKEN=
CLARITYOPS_DATA_DIR=./data
CLARITYOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
